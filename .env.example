# Copy to .env and uncomment anything you want to override.
# Paths are relative to the project root unless you set an absolute path.
# dvc.yaml still lists the same default paths. Change both together.

# PROJECT_ROOT=
# PDF_PATH=data/raw/law.pdf
# RAW_ROWS_PATH=data/interim/raw_rows.json
# ARTICLES_PATH=data/processed/civil_code.json
# INDEX_DIR=data/index
# FIXTURE_PATH=tests/fixtures/articles_sample.json
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_ALT=minishlab/potion-multilingual-128M
# EMBEDDING_CACHE=D:/temp/fastembed_cache
# QUESTIONS_CI_PATH=data/eval/questions_ci.json
# QUESTIONS_FULL_PATH=data/eval/questions_full.json

# HTTP API
# API_HOST=127.0.0.1
# API_PORT=8000

# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MAX_TOKENS=512

# MLflow UI is http://127.0.0.1:5000.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT=civil-code-retrieval

