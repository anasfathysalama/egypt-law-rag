# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/


# Secrets
.env
.env.*
!.env.example

# Raw corpus cache (keep the directory marker and the DVC pointer)
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
!data/raw/.gitignore

# Cached PDF rows and the parsed corpus are DVC outputs
data/interim/*
!data/interim/.gitkeep
!data/interim/*.dvc
!data/interim/.gitignore

data/processed/*
!data/processed/.gitkeep
!data/processed/*.dvc
!data/processed/.gitignore
!data/processed/civil_code.json

# Vector index is a DVC output
data/index/*
!data/index/.gitkeep
!data/index/*.dvc
!data/index/.gitignore
!data/index/chunks.json
!data/index/vectors.npy

# Experiment tracking and data versioning
mlruns/
reports/mlflow/*
!reports/mlflow/.gitkeep
.cache/
.dvc/cache/
