# Cached PDF rows and the parsed corpus are DVC outputs
data/interim/*
!data/interim/.gitkeep
!data/interim/*.dvc
!data/interim/.gitignore

data/processed/*
!data/processed/.gitkeep
!data/processed/*.dvc
!data/processed/.gitignore

