# Copy to .env and uncomment anything you want to override.
# Paths are relative to the project root unless you set an absolute path.
# dvc.yaml still lists the same default paths. Change both together.

# PROJECT_ROOT=
# PDF_PATH=data/raw/law.pdf
# RAW_ROWS_PATH=data/interim/raw_rows.json
# ARTICLES_PATH=data/processed/civil_code.json
# INDEX_DIR=data/index
# FIXTURE_PATH=tests/fixtures/articles_sample.json
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# HTTP API
# API_HOST=127.0.0.1
# API_PORT=8000

# /ask calls this Qwen model on Groq. Create a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MAX_TOKENS=512

# Unused by /ask. Kept for a later evaluation judge.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
